{
    "name": "vivarium/core",
    "description": "The Vivarium core plugin",
    "type": "library",
    "license": "MPL-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Luca Cantoreggi",
            "email": "luca.cantoreggi@vivarium.cloud"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "infection/infection": "^0.35",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vivarium\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vivarium\\Test\\": "tests/"
        }
    },
    "replace": {
        "vivarium/assertion": "self.version",
        "vivarium/check": "self.version",
        "vivarium/collection": "self.version",
        "vivarium/comparator": "self.version",
        "vivarium/container": "self.version",
        "vivarium/dispatcher": "self.version",
        "vivarium/equality": "self.version",
        "vivarium/float": "self.version",
        "vivarium/type": "self.version"
    },
    "scripts": {
        "infection": "vendor/bin/infection --coverage=tests-results/phpunit --min-msi=85 --min-covered-msi=95 --threads=4",
        "phpcs":     "vendor/bin/phpcs --report=junit --report-file=tests-results/phpcs/phpcs.xml --cache=cache/phpcs/result.cache src tests",
        "psalm":     "vendor/bin/psalm --output-format=checkstyle > tests-results/psalm/psalm.xml",
        "phpmd":     "vendor/bin/phpmd analyze src --ruleset phpmd.xml --no-progress --reportfile-xml tests-results/phpmd/phpmd.xml",
        "phpstan":   "vendor/bin/phpstan analyse --no-ansi --error-format=checkstyle > tests-results/phpstan/phpstan.xml",
        "phpunit":   "vendor/bin/phpunit",

        "check" : [
            "@phpcs",
            "@phpmd",
            "@phpstan",
            "@psalm"
        ],
        "test" : [
            "@phpunit",
            "@infection"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    }
}
